# ==========================================
# Git Ignore Configuration
# ==========================================

# 1. Database folder (All downloaded stock data, cache, & screener exports)
database/
database/*
database/**/*

# 2. Legacy / Server Cache folders
server_data_cache/
server_data_cache/*

# 3. Data files generated by the app
*.csv
*.zip
*.parquet
*.sqlite
*.db

# 4. Whitelist template/preset files for the app
!presets/*.csv
!sample_symbols.csv

# 5. Python Bytecode & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv/
env/
venv/
ENV/

# 6. IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db